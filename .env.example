# Copie para .env (que NÃO vai para o GitHub) e ajuste.
# Nenhum secret real deve ser commitado. Em produção, use as Environment Variables do Render.
ENV=development
LOG_LEVEL=INFO
# Origem do site. A proteção de Origin (CSRF) compara com este valor: abra o site exatamente por ele
# (ex.: http://localhost:8000, e NÃO http://127.0.0.1:8000).
PUBLIC_BASE_URL=http://localhost:8000

# Banco de dados. Em desenvolvimento use SQLite (arquivo em ./data, ignorado pelo Git).
# Em produção (Render) será a URL do PostgreSQL, configurada nas Environment Variables.
DATABASE_URL=sqlite:///./data/minhoca.db

# Pool de conexões (só vale para PostgreSQL). Valores pequenos por causa do Render.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2

# --- Autenticação por código no e-mail (Etapa 3) ---
# EM PRODUÇÃO estes DOIS segredos são OBRIGATÓRIOS, DIFERENTES entre si e com 32+ caracteres
# (a aplicação não sobe sem eles). Gere cada um com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Em desenvolvimento, se ficarem vazios, é usado um valor fixo e INSEGURO (só para testes locais).
AUTH_SECRET_KEY=
IP_HASH_SECRET=

# Envio de e-mail. "console" mostra o código no terminal (SÓ desenvolvimento; é recusado em produção).
# O provedor de produção (API HTTPS) ainda será escolhido.
EMAIL_SENDER=console

# Parâmetros opcionais (valores padrão abaixo).
# AUTH_CODE_TTL_SECONDS=600
# AUTH_CODE_MAX_ATTEMPTS=5
# AUTH_CODE_MIN_INTERVAL_SECONDS=60
# AUTH_CODE_MAX_PER_EMAIL_PER_HOUR=5
# AUTH_CODE_MAX_PER_IP_PER_HOUR=20
# AUTH_SESSION_TTL_DAYS=30

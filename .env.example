# Copie para .env (que NÃO vai para o GitHub) e ajuste.
# Nenhum secret real deve ser commitado. Em produção, use as Environment Variables do Render.
ENV=development
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000

# Banco de dados. Em desenvolvimento use SQLite (arquivo em ./data, ignorado pelo Git).
# Em produção (Render) será a URL do PostgreSQL, configurada nas Environment Variables.
DATABASE_URL=sqlite:///./data/minhoca.db

# Pool de conexões (só vale para PostgreSQL). Valores pequenos por causa do Render.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
